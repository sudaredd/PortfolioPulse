<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.portfoliopulse</groupId>
        <artifactId>portfoliopulse-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>pulse-intel</artifactId>
    <name>Pulse Intel</name>
    <description>Advanced portfolio analysis using RAG and AI</description>

    <dependencies>
        <!-- Internal Modules -->
        <dependency>
            <groupId>com.portfoliopulse</groupId>
            <artifactId>pulse-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.portfoliopulse</groupId>
            <artifactId>pulse-ledger</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.portfoliopulse</groupId>
            <artifactId>pulse-heartbeat</artifactId>
            <version>${project.version}</version>
        </dependency>



        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
